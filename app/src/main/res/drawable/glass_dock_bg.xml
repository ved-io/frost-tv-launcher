<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Milky Frosted Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/glass_dark_base" />
        </shape>
    </item>
    <!-- Layer 1: Frosted White Mist Gradient Sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="#38FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#08FFFFFF" />
            <stroke
                android:width="1.0dp"
                android:color="#48DCE6F2" />
        </shape>
    </item>
</layer-list>
