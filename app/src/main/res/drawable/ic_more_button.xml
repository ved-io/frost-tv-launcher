<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="#363040" />
        </shape>
    </item>
    <item
        android:top="15dp"
        android:bottom="15dp"
        android:left="15dp"
        android:right="15dp">
        <shape android:shape="oval">
            <solid android:color="#4D455A" />
            <stroke
                android:width="1.5dp"
                android:color="#786E88" />
        </shape>
    </item>
</layer-list>
